# Copy to .env and fill in. .env is gitignored; .env.example is committed.
# Local dev uses a local PostgreSQL 18 + pgvector (e.g. via pgAdmin) on :5432.
GEMINI_API_KEY=your-google-ai-studio-key
DATABASE_URL=postgresql+psycopg://postgres:your-pw@localhost:5432/rag_db
TEST_DATABASE_URL=postgresql+psycopg://postgres:your-pw@localhost:5432/rag_test
GENERATION_MODEL=gemini/gemini-2.5-pro
GRADER_MODEL=gemini/gemini-2.5-flash
EMBEDDING_MODEL=gemini/text-embedding-004
EMBEDDING_DIM=768
