# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual envs
.venv/
venv/
env/

# Env / secrets — never commit real secrets; the example IS tracked
.env
.env.*
!.env.example

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Data & artifacts — corpus and generated indexes stay out of git
data/raw/
data/processed/
*.db
*.sqlite3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs
*.log
